{
  "name": "service-loom-js",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run build && vitest run",
    "test:watch": "vitest",
    "verify": "turbo run typecheck lint && vitest run",
    "demo": "cd apps/demo && npm run dev",
    "local-test": "cd packages/service-loom-js/src/__local_tests && tsx --"
  },
  "devDependencies": {
    "turbo": "^2.9.14",
    "vitest": "^4.0.0"
  },
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=22"
  }
}
