{
  "name": "@baby-yak/service-loom-react",
  "version": "1.0.3",
  "description": "React hooks and utilities for @baby-yak/service-loom-js",
  "license": "MIT",
  "author": "its.yak@gmail.com",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/baby-yak/service-loom-js",
    "directory": "packages/service-loom-react"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "peerDependencies": {
    "@baby-yak/service-loom-js": "^1.0.0",
    "react": ">=17"
  },
  "devDependencies": {
    "@baby-yak/service-loom-js": "*",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "react": "^19.0.0",
    "tsdown": "^0.22.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "react",
    "state",
    "typed",
    "typescript",
    "hooks",
    "reactive"
  ]
}
